<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="description" content="{{ brand }} — Quiet Mineral Editorial skincare landing page demo">
<title>{{ brand }} — Make Room For You</title>
<style>
:root{
  --paper:{{ t.colors.paper }};--paper2:{{ t.colors.paper2 }};--ink:{{ t.colors.ink }};--muted:{{ t.colors.muted }};
  --sage:{{ t.colors.sage }};--sage-dark:{{ t.colors.sage_dark }};--charcoal:{{ t.colors.charcoal }};--white:{{ t.colors.white }};--line:{{ t.colors.line }};
  --display:{{ t.type.display }};--sans:{{ t.type.sans }};--ease:{{ t.motion.ease }};
  --pad:clamp(24px,5vw,78px);--max:1440px;
}
*{box-sizing:border-box}html{scroll-behavior:smooth;background:#ddd9d0}body{margin:0;color:var(--ink);background:var(--paper);font-family:var(--display);overflow-x:hidden}
a{color:inherit;text-decoration:none}button{font:inherit;color:inherit}img{display:block;width:100%;height:100%;object-fit:cover}.site{max-width:var(--max);margin:auto;background:var(--paper);overflow:hidden;box-shadow:0 24px 90px rgba(32,31,27,.08)}
.progress{position:fixed;z-index:1000;left:0;top:0;height:2px;background:var(--sage-dark);width:0;transform-origin:left center}.topbar{position:absolute;z-index:30;top:0;left:50%;transform:translateX(-50%);width:min(100%,var(--max));height:88px;display:flex;align-items:center;padding:0 var(--pad);border-bottom:1px solid rgba(255,255,255,.25);mix-blend-mode:multiply}.brand{font:600 15px/1 var(--sans);letter-spacing:.34em;white-space:nowrap}.nav{margin-left:auto;display:flex;align-items:center;gap:clamp(18px,2.5vw,42px);font:600 10px/1 var(--sans);letter-spacing:.16em}.nav-cta{padding:15px 18px;border:1px solid rgba(36,37,31,.55)}
.section{position:relative}.label{font:600 10px/1 var(--sans);letter-spacing:.25em;text-transform:uppercase;display:flex;align-items:center;gap:18px}.label::after{content:"";width:42px;height:1px;background:currentColor;opacity:.55}.boundary{position:absolute;z-index:8;left:0;right:0;bottom:-1px;height:clamp(70px,8vw,140px);pointer-events:none}.boundary svg{width:100%;height:100%;display:block}.boundary path{fill:var(--boundary-fill)}
.reveal{opacity:0;transform:translateY(28px);transition:opacity .9s var(--ease),transform .9s var(--ease)}.reveal.in{opacity:1;transform:none}.reveal[data-delay="1"]{transition-delay:.12s}.reveal[data-delay="2"]{transition-delay:.24s}.reveal[data-delay="3"]{transition-delay:.36s}.rule-reveal{transform:scaleX(0);transform-origin:left;transition:transform 1.15s var(--ease)}.rule-reveal.in{transform:scaleX(1)}

/* HERO */
.hero{min-height:860px;display:grid;grid-template-columns:43% 57%;background:var(--paper2)}.hero-copy{position:relative;z-index:4;padding:190px 5vw 170px var(--pad);display:flex;flex-direction:column;justify-content:center}.hero-copy .eyebrow{font:600 10px/1 var(--sans);letter-spacing:.25em;margin-bottom:34px}.hero h1{font-size:clamp(52px,6vw,92px);line-height:1.08;font-weight:400;letter-spacing:-.03em;margin:0 0 32px;white-space:pre-line}.hero-copy p{max-width:390px;font-size:14px;line-height:2.05;letter-spacing:.055em;margin:0;color:#4d5048}.text-link{display:inline-flex;align-items:center;gap:18px;margin-top:38px;font:600 10px/1 var(--sans);letter-spacing:.18em}.text-link::before{content:"";width:38px;height:1px;background:currentColor;transition:width .4s var(--ease)}.text-link:hover::before{width:64px}.hero-media{position:relative;overflow:hidden;min-height:860px}.hero-media::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(231,224,212,.15),transparent 40%)}.hero-media img{transform:scale(1.04);animation:heroBreath 14s ease-in-out infinite alternate}.hero-ghost{position:absolute;z-index:3;left:-4%;bottom:6%;font:500 clamp(100px,16vw,248px)/.75 var(--sans);letter-spacing:-.08em;color:transparent;-webkit-text-stroke:1px rgba(36,37,31,.13);user-select:none;pointer-events:none}.hero-mark{position:absolute;z-index:5;right:28px;bottom:145px;writing-mode:vertical-rl;font:600 9px/1 var(--sans);letter-spacing:.24em}.hero-mark::before{content:"";display:block;width:1px;height:80px;background:var(--ink);margin:0 auto 16px;opacity:.5}@keyframes heroBreath{from{transform:scale(1.03) translate3d(0,0,0)}to{transform:scale(1.08) translate3d(-1.2%,.8%,0)}}

/* CONCEPT */
.concept{padding:180px var(--pad) 220px;background:var(--white)}.concept-grid{display:grid;grid-template-columns:1.08fr .92fr;gap:8vw;align-items:start}.concept-number{font:500 11px/1 var(--sans);letter-spacing:.22em;margin-bottom:54px;color:var(--muted)}.concept h2{font-size:clamp(38px,5vw,70px);line-height:1.34;font-weight:400;letter-spacing:-.02em;white-space:pre-line;margin:0}.concept-copy{padding-top:118px}.concept-copy p{font-size:14px;line-height:2.25;letter-spacing:.045em;margin:0 0 56px;color:#51534c}.concept-media{height:400px;overflow:hidden;border-radius:42% 42% 8px 8px / 26% 26% 8px 8px}.concept-media img{transition:transform 1.5s var(--ease)}.concept-media.in img{transform:scale(1.035)}

/* APPROACH */
.approach{background:var(--paper);padding:170px var(--pad) 180px}.approach-head{display:grid;grid-template-columns:1.05fr .95fr;gap:9vw;align-items:end;margin-bottom:90px}.approach h2{font-size:clamp(42px,5.5vw,76px);line-height:1.28;font-weight:400;white-space:pre-line;margin:22px 0 0}.approach-intro{font-size:14px;line-height:2.2;color:#56594f;margin:0 0 8px}.pillars{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.pillar{min-height:360px;padding:44px 34px 36px;border-right:1px solid var(--line);display:flex;flex-direction:column}.pillar:last-child{border-right:0}.pillar-n{font:600 10px/1 var(--sans);letter-spacing:.2em;color:var(--sage-dark)}.pillar h3{font-size:clamp(24px,2.5vw,34px);line-height:1.55;font-weight:400;white-space:pre-line;margin:72px 0 24px}.pillar p{font-size:13px;line-height:2;color:#575950;margin:auto 0 0}

/* INGREDIENTS */
.ingredients{background:var(--charcoal);color:var(--white);padding:180px var(--pad) 210px;overflow:hidden}.ingredients .label{color:#c8cec7}.ingredients-head{display:grid;grid-template-columns:1.05fr .95fr;gap:8vw}.ingredients h2{font-size:clamp(40px,5vw,72px);line-height:1.3;font-weight:400;white-space:pre-line;margin:26px 0 0}.ingredients-copy{padding-top:64px}.ingredients-copy p{font-size:13px;line-height:2.15;color:#c3c8c0;max-width:520px}.orbit-wrap{position:relative;min-height:540px;margin-top:84px}.orbit-core{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:min(24vw,320px);aspect-ratio:1;border:1px solid rgba(255,255,255,.18);border-radius:50%;display:grid;place-items:center;text-align:center}.orbit-core::before,.orbit-core::after{content:"";position:absolute;border:1px solid rgba(255,255,255,.09);border-radius:50%}.orbit-core::before{inset:-46%}.orbit-core::after{inset:-88%}.orbit-core span{font:500 11px/1.6 var(--sans);letter-spacing:.28em}.ingredient-item{position:absolute;width:250px}.ingredient-item:nth-child(2){left:4%;top:6%}.ingredient-item:nth-child(3){right:2%;top:19%}.ingredient-item:nth-child(4){left:14%;bottom:0}.ingredient-item .name{font:500 clamp(30px,3vw,48px)/1 var(--sans);letter-spacing:.02em}.ingredient-item .jp{font-size:14px;margin:10px 0 16px}.ingredient-item .note{font-size:12px;line-height:1.9;color:#bfc3bc}.ingredients .disclaimer{font:500 10px/1.8 var(--sans);letter-spacing:.04em;color:#8f958d;margin-top:42px;max-width:780px}

/* PRODUCT */
.product{background:var(--white);padding:190px var(--pad) 170px}.product-layout{display:grid;grid-template-columns:1.12fr .88fr;gap:7vw;align-items:start}.product-media{height:650px;overflow:hidden;position:relative;border-radius:2px}.product-media img{transition:transform 1.7s var(--ease);transform:scale(1.04)}.product-media.in img{transform:scale(1)}.product-copy{padding-top:34px}.product h2{font-size:clamp(42px,5vw,72px);line-height:1.28;font-weight:400;white-space:pre-line;margin:26px 0 34px}.product-copy>p{font-size:13px;line-height:2.15;color:#55584f;max-width:520px}.product-list{margin-top:54px;border-top:1px solid var(--line)}.product-row{display:grid;grid-template-columns:1fr auto;gap:20px;padding:25px 0;border-bottom:1px solid var(--line)}.product-name{font:600 13px/1.3 var(--sans);letter-spacing:.12em}.product-type{font:500 9px/1.5 var(--sans);letter-spacing:.14em;color:var(--muted);margin-top:5px}.product-meta{text-align:right;font:500 10px/1.65 var(--sans);letter-spacing:.07em;color:#565950}

/* RITUAL */
.ritual{background:var(--paper2);padding:170px var(--pad) 190px}.ritual-head{display:grid;grid-template-columns:1fr 1fr;gap:8vw}.ritual h2{font-size:clamp(40px,5vw,68px);line-height:1.32;font-weight:400;white-space:pre-line;margin:24px 0 0}.ritual-head p{font-size:13px;line-height:2.2;color:#55574f;padding-top:62px}.steps{position:relative;margin-top:110px;display:grid;grid-template-columns:repeat(3,1fr);gap:4vw}.steps::before{content:"";position:absolute;left:0;right:0;top:21px;height:1px;background:var(--line);transform-origin:left;transform:scaleX(0);transition:transform 1.4s var(--ease)}.steps.in::before{transform:scaleX(1)}.step{position:relative;padding-top:62px}.step::before{content:"";position:absolute;top:15px;left:0;width:13px;height:13px;border-radius:50%;border:1px solid var(--sage-dark);background:var(--paper2)}.step-n{font:600 10px/1 var(--sans);letter-spacing:.18em;color:var(--sage-dark)}.step h3{font-size:24px;font-weight:400;margin:26px 0 16px}.step p{font-size:12px;line-height:2;color:#5d6057;margin:0}

/* STORY */
.story{background:var(--paper);padding:160px var(--pad) 210px}.story-grid{display:grid;grid-template-columns:.95fr 1.05fr;gap:7vw;align-items:center}.story-media{height:620px;overflow:hidden;border-radius:52% 52% 0 0 / 24% 24% 0 0;position:relative}.story-media img{transform:scale(1.08)}.story-copy h2{font-size:clamp(38px,4.7vw,64px);line-height:1.38;font-weight:400;white-space:pre-line;margin:24px 0 30px}.story-copy p{font-size:13px;line-height:2.2;color:#55574f;max-width:520px}.story-quote{font:500 clamp(54px,7vw,108px)/.95 var(--sans);letter-spacing:-.045em;white-space:pre-line;margin-top:56px;color:transparent;-webkit-text-stroke:1px rgba(36,37,31,.32)}

/* VOICE */
.voice{background:var(--white);padding:180px var(--pad)}.voice-head{display:grid;grid-template-columns:1.1fr .9fr;gap:9vw;align-items:end}.voice h2{font-size:clamp(40px,5vw,70px);line-height:1.34;font-weight:400;white-space:pre-line;margin:24px 0 0}.voice-intro{font-size:12px;line-height:2;color:#62645c}.voice-list{margin-top:90px;border-top:1px solid var(--line)}.voice-item{display:grid;grid-template-columns:1fr 200px;gap:30px;padding:46px 0;border-bottom:1px solid var(--line);align-items:center}.voice-item blockquote{font-size:clamp(22px,2.7vw,38px);line-height:1.55;font-weight:400;margin:0}.voice-meta{font:600 9px/1.5 var(--sans);letter-spacing:.16em;color:var(--muted);text-align:right}

/* FAQ */
.faq{background:var(--paper);padding:170px var(--pad) 190px}.faq-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:9vw}.faq h2{font-size:clamp(38px,4.5vw,62px);line-height:1.35;font-weight:400;white-space:pre-line;margin:24px 0 0}.faq-list{border-top:1px solid var(--line)}.faq-item{border-bottom:1px solid var(--line)}.faq-q{width:100%;background:none;border:0;padding:28px 0;display:grid;grid-template-columns:1fr 32px;gap:20px;text-align:left;cursor:pointer;font-size:15px;line-height:1.6}.faq-q span:last-child{font:300 24px/1 var(--sans);transition:transform .35s var(--ease);text-align:center}.faq-item.open .faq-q span:last-child{transform:rotate(45deg)}.faq-a{display:grid;grid-template-rows:0fr;transition:grid-template-rows .45s var(--ease)}.faq-a>div{overflow:hidden}.faq-a p{font-size:12px;line-height:2;color:#585a52;margin:0;padding:0 58px 28px 0}.faq-item.open .faq-a{grid-template-rows:1fr}

/* FINAL */
.final{min-height:760px;background:var(--charcoal);color:var(--white);position:relative;display:grid;place-items:center;text-align:center;padding:130px var(--pad);overflow:hidden}.final::before,.final::after{content:"";position:absolute;border:1px solid rgba(255,255,255,.10);border-radius:50%}.final::before{width:620px;height:620px;left:-220px;top:80px}.final::after{width:460px;height:460px;right:-160px;bottom:-110px}.final .eyebrow{font:600 9px/1 var(--sans);letter-spacing:.24em;color:#b8beb6;margin-bottom:36px}.final h2{font-size:clamp(48px,7vw,96px);line-height:1.2;font-weight:400;white-space:pre-line;margin:0 auto 32px;max-width:920px}.final p{font-size:13px;line-height:2;color:#c4c9c2;max-width:570px;margin:0 auto}.cta-solid{display:inline-flex;align-items:center;justify-content:center;min-width:230px;height:58px;margin-top:44px;border:1px solid rgba(255,255,255,.55);font:600 10px/1 var(--sans);letter-spacing:.2em;position:relative;overflow:hidden}.cta-solid::before{content:"";position:absolute;inset:0;background:var(--white);transform:translateY(102%);transition:transform .45s var(--ease)}.cta-solid span{position:relative;z-index:1;transition:color .45s}.cta-solid:hover::before{transform:none}.cta-solid:hover span{color:var(--charcoal)}.final-sub{position:absolute;left:var(--pad);bottom:36px;font:600 10px/1 var(--sans);letter-spacing:.24em;color:#838a82}
footer{background:var(--charcoal);color:#838a82;border-top:1px solid rgba(255,255,255,.08);padding:28px var(--pad);display:flex;justify-content:space-between;gap:20px;font:500 9px/1.6 var(--sans);letter-spacing:.09em}

@media(max-width:900px){
  .topbar{height:70px}.nav a:not(.nav-cta){display:none}.nav-cta{padding:12px 14px}.hero{grid-template-columns:1fr;min-height:auto}.hero-copy{padding:150px var(--pad) 90px;min-height:560px}.hero h1{font-size:clamp(52px,14vw,78px)}.hero-media{min-height:600px}.hero-ghost{font-size:34vw;bottom:3%}.hero-mark{bottom:80px}.concept{padding-top:130px}.concept-grid,.approach-head,.ingredients-head,.product-layout,.ritual-head,.story-grid,.voice-head,.faq-grid{grid-template-columns:1fr}.concept-copy{padding-top:44px}.concept-media{height:300px}.pillars{grid-template-columns:1fr}.pillar{min-height:auto;border-right:0;border-bottom:1px solid var(--line);padding:32px 0}.pillar:last-child{border-bottom:0}.pillar h3{margin:34px 0 18px}.orbit-wrap{min-height:620px}.orbit-core{width:210px}.ingredient-item{width:190px}.ingredient-item:nth-child(2){left:0;top:4%}.ingredient-item:nth-child(3){right:0;top:16%}.ingredient-item:nth-child(4){left:8%;bottom:2%}.product-media{height:520px}.product-copy{padding-top:0}.ritual-head p{padding-top:18px}.steps{grid-template-columns:1fr;margin-top:70px}.steps::before{left:6px;top:0;bottom:0;width:1px;height:auto;transform:scaleY(0);transform-origin:top}.steps.in::before{transform:scaleY(1)}.step{padding:0 0 42px 44px}.step::before{top:0;left:0}.story-media{height:520px}.story-grid{display:flex;flex-direction:column-reverse}.voice-item{grid-template-columns:1fr}.voice-meta{text-align:left}.faq-list{margin-top:50px}.final{min-height:690px}
}
@media(max-width:560px){
  :root{--pad:22px}.brand{font-size:12px}.hero-copy{padding-top:124px;min-height:490px}.hero-copy p{font-size:13px}.hero-media{min-height:470px}.concept,.approach,.ingredients,.product,.ritual,.story,.voice,.faq{padding-left:var(--pad);padding-right:var(--pad)}.concept{padding-bottom:170px}.approach{padding-top:125px;padding-bottom:130px}.ingredients{padding-top:130px;padding-bottom:170px}.product{padding-top:150px}.product-media{height:410px}.orbit-wrap{min-height:560px}.orbit-core{width:150px}.ingredient-item{width:150px}.ingredient-item .name{font-size:25px}.product-row{grid-template-columns:1fr}.product-meta{text-align:left}.story-media{height:430px}.voice{padding-top:140px}.voice-item blockquote{font-size:24px}.faq{padding-top:130px}.final h2{font-size:clamp(44px,13vw,64px)}footer{flex-direction:column}
}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}.reveal,.rule-reveal,.hero-media img,.product-media img,.faq-a{transition:none!important;animation:none!important}.reveal{opacity:1!important;transform:none!important}}
</style>
</head>
<body>
<a class="skip-link" href="#{{sections[0].id}}">本文へ移動</a>
<div class="progress" id="progress"></div>
<div class="site">
<header class="topbar">
  <a class="brand" href="#{{sections[0].id}}">{{ brand }}</a>
  <nav class="nav">
    {% for n in sections[1:6] %}<a href="#{{n.id}}">{{n.label or n.id}}</a>{% endfor %}
    <a class="nav-cta" href="#{{sections[-1].id}}">{{ nav_cta }}</a>
  </nav>
</header>
{{ rendered_scenes | safe }}
<footer><span>© {{ brand }} — DESIGN DEMO</span><span>Fictional brand / No actual product claims.</span></footer>
</div>

<script>
const progress=document.getElementById('progress');
const updateProgress=()=>{const d=document.documentElement;const max=d.scrollHeight-innerHeight;progress.style.width=(max?scrollY/max*100:0)+'%'};addEventListener('scroll',updateProgress,{passive:true});updateProgress();
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.12,rootMargin:'0px 0px -5%'});document.querySelectorAll('.reveal,.observe-line').forEach(el=>io.observe(el));
const parallax=matchMedia('(prefers-reduced-motion: reduce)').matches?[]:[...document.querySelectorAll('[data-parallax]')];let ticking=false;const tick=()=>{const vh=innerHeight;parallax.forEach(el=>{const r=el.getBoundingClientRect();const k=parseFloat(el.dataset.parallax||'.06');const center=(r.top+r.height/2-vh/2)/vh;const img=el.querySelector('img');if(img)img.style.translate=`0 ${center*k*100}px`});ticking=false};addEventListener('scroll',()=>{if(!ticking){requestAnimationFrame(tick);ticking=true}},{passive:true});tick();
document.querySelectorAll('.faq-q').forEach(btn=>btn.addEventListener('click',()=>{const item=btn.closest('.faq-item');const open=item.classList.toggle('open');btn.setAttribute('aria-expanded',open?'true':'false')}));
</script>
</body></html>
