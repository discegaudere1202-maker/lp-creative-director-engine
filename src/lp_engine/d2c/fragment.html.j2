
{% if s.type == 'split_hero' %}
<section class="section hero" id="{{s.id}}" data-scene-id="{{s.scene_id}}" data-motion-job="{{s.motion_job}}" data-mobile-transform="{{s.mobile_transformation.mode}}" style="{{scene_style(s)}}">{{ boundary_in(s) | safe }}
  <div class="hero-copy">
    <div class="eyebrow reveal">{{s.eyebrow}}</div>
    <h1 class="reveal" data-delay="1">{{s.title}}</h1>
    <p class="reveal" data-delay="2">{{s.body}}</p>
    <a class="text-link reveal" data-delay="3" href="{{s.cta_href}}">{{s.cta.label}}</a>
  </div>
  <div class="hero-media" data-parallax=".12"><img src="{{s.media}}" alt="{{ brand }} visual"><div class="hero-ghost">{{s.art.oversized_word}}</div><div class="hero-mark">SCROLL TO DISCOVER</div></div>
  
</section>
{% elif s.type == 'editorial_intro' %}
<section class="section concept" id="{{s.id}}" data-scene-id="{{s.scene_id}}" data-motion-job="{{s.motion_job}}" data-mobile-transform="{{s.mobile_transformation.mode}}" style="{{scene_style(s)}}">{{ boundary_in(s) | safe }}
  <div class="concept-grid">
    <div><div class="concept-number reveal">{{s.art.number}} / {{s.label}}</div><h2 class="reveal" data-delay="1">{{s.title}}</h2></div>
    <div class="concept-copy"><p class="reveal">{{s.body}}</p><div class="concept-media reveal" data-delay="1"><img src="{{s.media}}" alt="{{ brand }} concept"></div></div>
  </div>
  
</section>
{% elif s.type == 'pillars' %}
<section class="section approach" id="{{s.id}}" data-scene-id="{{s.scene_id}}" data-motion-job="{{s.motion_job}}" data-mobile-transform="{{s.mobile_transformation.mode}}" style="{{scene_style(s)}}">{{ boundary_in(s) | safe }}<div class="approach-head"><div><div class="label reveal">{{s.label}}</div><h2 class="reveal" data-delay="1">{{s.title}}</h2></div><p class="approach-intro reveal">{{s.intro}}</p></div>
<div class="pillars">{% for item in s['items'] %}<article class="pillar reveal" data-delay="{{loop.index0}}"><div class="pillar-n">{{item.n}}</div><h3>{{item.title}}</h3><p>{{item.body}}</p></article>{% endfor %}</div></section>
{% elif s.type == 'ingredient_orbit' %}
<section class="section ingredients" id="{{s.id}}" data-scene-id="{{s.scene_id}}" data-motion-job="{{s.motion_job}}" data-mobile-transform="{{s.mobile_transformation.mode}}" style="{{scene_style(s)}}">{{ boundary_in(s) | safe }}<div class="ingredients-head"><div><div class="label reveal">{{s.label}}</div><h2 class="reveal" data-delay="1">{{s.title}}</h2></div><div class="ingredients-copy"><p class="reveal">{{s.body}}</p></div></div>
<div class="orbit-wrap"><div class="orbit-core"><span>{{ brand }}<br>FORMULA<br>PHILOSOPHY</span></div>{% for item in s['items'] %}<article class="ingredient-item reveal" data-delay="{{loop.index0}}"><div class="name">{{item.name}}</div><div class="jp">{{item.jp}}</div><div class="note">{{item.note}}</div></article>{% endfor %}</div><p class="disclaimer">{{s.disclaimer}}</p></section>
{% elif s.type == 'product_spotlight' %}
<section class="section product" id="{{s.id}}" data-scene-id="{{s.scene_id}}" data-motion-job="{{s.motion_job}}" data-mobile-transform="{{s.mobile_transformation.mode}}" style="{{scene_style(s)}}">{{ boundary_in(s) | safe }}<div class="product-layout"><div class="product-media reveal" data-parallax=".06"><img src="{{s.media}}" alt="{{ brand }} products"></div><div class="product-copy"><div class="label reveal">{{s.label}}</div><h2 class="reveal" data-delay="1">{{s.title}}</h2><p class="reveal" data-delay="2">{{s.body}}</p><div class="product-list">{% for p in s.products %}<div class="product-row reveal" data-delay="{{loop.index0}}"><div><div class="product-name">{{p.name}}</div><div class="product-type">{{p.type}}</div></div><div class="product-meta">{{p.size}}<br>{{p.price}}</div></div>{% endfor %}</div><a class="text-link reveal" href="{{s.cta_href}}">{{s.cta.label}}</a></div></div></section>
{% elif s.type == 'ritual_steps' %}
<section class="section ritual" id="{{s.id}}" data-scene-id="{{s.scene_id}}" data-motion-job="{{s.motion_job}}" data-mobile-transform="{{s.mobile_transformation.mode}}" style="{{scene_style(s)}}">{{ boundary_in(s) | safe }}<div class="ritual-head"><div><div class="label reveal">{{s.label}}</div><h2 class="reveal" data-delay="1">{{s.title}}</h2></div><p class="reveal">{{s.body}}</p></div><div class="steps observe-line">{% for st in s.steps %}<article class="step reveal" data-delay="{{loop.index0}}"><div class="step-n">STEP {{st.n}}</div><h3>{{st.title}}</h3><p>{{st.body}}</p></article>{% endfor %}</div></section>
{% elif s.type == 'story_quote' %}
<section class="section story" id="{{s.id}}" data-scene-id="{{s.scene_id}}" data-motion-job="{{s.motion_job}}" data-mobile-transform="{{s.mobile_transformation.mode}}" style="{{scene_style(s)}}">{{ boundary_in(s) | safe }}<div class="story-grid"><div class="story-media reveal" data-parallax=".08"><img src="{{s.media}}" alt="{{ brand }} story"></div><div class="story-copy"><div class="label reveal">{{s.label}}</div><h2 class="reveal" data-delay="1">{{s.title}}</h2><p class="reveal" data-delay="2">{{s.body}}</p><div class="story-quote reveal" data-delay="3">{{s.quote}}</div></div></div></section>
{% elif s.type == 'voice_cards' %}
<section class="section voice" id="{{s.id}}" data-scene-id="{{s.scene_id}}" data-motion-job="{{s.motion_job}}" data-mobile-transform="{{s.mobile_transformation.mode}}" style="{{scene_style(s)}}">{{ boundary_in(s) | safe }}<div class="voice-head"><div><div class="label reveal">{{s.label}}</div><h2 class="reveal" data-delay="1">{{s.title}}</h2></div><p class="voice-intro reveal">{{s.intro}}</p></div><div class="voice-list">{% for v in s['items'] %}<article class="voice-item reveal"><blockquote>「{{v.text}}」</blockquote><div class="voice-meta">{{v.meta}}</div></article>{% endfor %}</div></section>
{% elif s.type == 'faq' %}
<section class="section faq" id="{{s.id}}" data-scene-id="{{s.scene_id}}" data-motion-job="{{s.motion_job}}" data-mobile-transform="{{s.mobile_transformation.mode}}" style="{{scene_style(s)}}">{{ boundary_in(s) | safe }}<div class="faq-grid"><div><div class="label reveal">{{s.label}}</div><h2 class="reveal" data-delay="1">{{s.title}}</h2></div><div class="faq-list reveal">{% for f in s['items'] %}<div class="faq-item"><button class="faq-q" aria-expanded="false"><span>{{f.q}}</span><span>＋</span></button><div class="faq-a"><div><p>{{f.a}}</p></div></div></div>{% endfor %}</div></div></section>
{% elif s.type == 'final_cta' %}
<section class="section final" id="{{s.id}}" data-scene-id="{{s.scene_id}}" data-motion-job="{{s.motion_job}}" data-mobile-transform="{{s.mobile_transformation.mode}}" style="{{scene_style(s)}}">{{ boundary_in(s) | safe }}<div><div class="eyebrow reveal">{{s.eyebrow}}</div><h2 class="reveal" data-delay="1">{{s.title}}</h2><p class="reveal" data-delay="2">{{s.body}}</p><a class="cta-solid reveal" data-delay="3" href="{{s.cta_href}}"><span>{{s.cta.label}} ↗</span></a></div><div class="final-sub">{{s.sub}}</div></section>
{% endif %}
