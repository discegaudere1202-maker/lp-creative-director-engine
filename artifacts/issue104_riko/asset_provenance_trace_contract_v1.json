{
  "schema_version": "issue104_asset_provenance_trace_contract_v1",
  "trace_scope": "one bound visual asset per scene/media-role placement",
  "required_fields": [
    "generation_id",
    "composition_plan_id",
    "family_id",
    "family_frozen",
    "scene_id",
    "scene_intent",
    "media_role",
    "required_content_conditions",
    "industry",
    "business_category",
    "catalog_version",
    "candidate_query_fingerprint",
    "candidate_asset_ids",
    "candidate_rejections",
    "selected_asset_id",
    "source_provider",
    "source_id",
    "source_url",
    "license_terms_url",
    "license_terms_checked_at",
    "rights_gate_state",
    "rights_conditions",
    "evidence_status",
    "usage_ledger_snapshot_id",
    "reuse_penalty_factors",
    "crop_variant_id",
    "focal_point",
    "binary_sha256",
    "renderer_binding_id"
  ],
  "candidate_rejection_reason_codes": [
    "CONTENT_CLASS_MISMATCH",
    "SCENE_INTENT_MISMATCH",
    "ROLE_MISMATCH",
    "ORIENTATION_CROP_BLOCKED",
    "PERSON_CONTEXT_MISMATCH",
    "LICENSE_BLOCKED",
    "COMMERCIAL_USE_BLOCKED",
    "ATTRIBUTION_BLOCKED",
    "PERSON_RIGHTS_REVIEW_REQUIRED",
    "PROPERTY_RIGHTS_REVIEW_REQUIRED",
    "TRADEMARK_REVIEW_REQUIRED",
    "EVIDENCE_BOUNDARY_MISMATCH",
    "STALE_OR_REVOKED",
    "BINARY_HASH_MISMATCH",
    "BATCH_HERO_REUSE_BLOCKED",
    "REUSE_PENALTY"
  ],
  "audit_invariants": [
    "family_frozen must be true",
    "family_id equals CompositionPlan family and is not asset-derived",
    "business_category affects candidate query only",
    "selected asset must appear in candidate_asset_ids",
    "selected asset must pass rights gate",
    "selected binary hash must match renderer-bound binary",
    "generic evidence_status cannot be used as actual-company evidence",
    "all rejected candidates retain reason codes",
    "screenshot manifest can be joined back to selected_asset_id + binary_sha256"
  ],
  "human_audit_fields": [
    "visual_fit_note",
    "stock_obviousness_note",
    "misidentification_risk_note",
    "crop_quality_note",
    "template_smell_note",
    "aoi_decision"
  ]
}
