  "scoring": {
    "score_direction": "HIGHER_IS_BETTER",
    "raw_scale": {"min": 0, "max": 5, "unknown": null},
    "normalization_formula": "normalized_category_score = SUM((raw_dimension_score / 5) * dimension_weight)",
    "overall_formula": "overall_score = design_score + conversion_architecture_score + motion_score + implementation_feasibility_score",
    "dimensions": {
      "design": {
        "target_max": 40,
        "weights": {
          "hero_originality": 4,
          "typography": 4,
          "layout_composition": 4,
          "image_treatment": 4,
          "visual_hierarchy": 4,
          "section_rhythm": 4,
          "section_boundary": 3,
          "brand_distinctiveness": 4,
          "screenshot_worthy_quality": 4,
          "design_distinctiveness": 5
        }
      },
      "conversion_architecture": {
        "target_max": 30,
        "weights": {
          "proof_presentation": 5,
          "cta_clarity": 4,
          "navigation_utility": 3,
          "conversion_clarity": 5,
          "objection_coverage": 5,
          "decision_size": 4,
          "customer_state_fit": 4
        },
        "meaning": "Observable conversion design structure, not measured CVR or revenue performance"
      },
      "motion": {
        "target_max": 15,
        "weights": {
          "motion_job": 4,
          "interaction_legibility": 3,
          "scroll_experience": 3,
          "timing_rhythm": 3,
          "reduced_motion_safety": 2
        }
      },
      "implementation_feasibility": {
        "target_max": 15,
        "weights": {
          "html_css_feasibility": 2,
          "asset_availability": 2,
          "mobile_quality": 4,
          "responsive_recomposition": 3,
          "performance_discipline": 2,
          "accessibility_maintenance_safety": 2
        }
      }
    },
    "strong_threshold": {
      "design_min": 32,
      "conversion_architecture_min": 20,
      "motion_min": 9,
      "implementation_feasibility_min": 9,
      "overall_min": 70,
      "minimum_raw_dimension_score": 2,
      "original_or_official_evidence_required": true,
      "production_core_mobile_grade_required": "E3"
    },
    "design_distinctiveness_rule": {
      "design_distinctiveness": "0 = generic / highly template-like, 5 = clearly authored and distinctive",
      "template_resemblance_risk_derived": "5 - design_distinctiveness",
      "risk_is_not_a_positive_score": true
    }
  },
  "retrieval": {
    "candidate_score_formula": "SUM(feature_score * feature_weight)",
    "weights": {
      "axis_similarity": 0.18,
      "truth_tag_match": 0.14,
      "buyer_state_fit": 0.12,
      "marketing_job_fit": 0.12,
      "evidence_authority_fit": 0.10,
      "expression_driver_fit": 0.05,
      "archetype_fit": 0.08,
      "conversion_utility": 0.08,
      "evidence_confidence": 0.06,
      "implementation_fit": 0.07
    },
