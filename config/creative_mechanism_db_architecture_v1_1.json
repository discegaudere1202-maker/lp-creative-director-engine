  "conversion_architecture_policy": {
    "display_name": "Conversion Architecture Quality",
    "observable_dimensions":["cta_clarity","objection_coverage","decision_size","proof_presentation","customer_state_fit","conversion_clarity","navigation_utility"],
    "forbidden_inference":["measured_cvr","revenue_lift","lead_increase","mechanism_caused_conversion"],
    "observed_performance_evidence_entity":"observed_performance_evidence",
    "performance_evidence_allowed_only_when":"Official case study or public measurement with source, metric, period, population and methodology is available"
  },
  "observed_performance_evidence_schema": {
    "required_fields":["evidence_id","reference_id","metric","value","unit","measurement_period","population_or_sample","methodology","source_url","source_role","captured_at"],
    "claim_rule":"Performance may be stored as reported evidence, never inferred from visual observation"
  },
  "creative_profile": {
    "axis_value_range":[0,1],
    "axis_value_rule":"Axis values require input evidence and a derivation rule. Missing evidence produces UNKNOWN, not a guessed low or high value.",
    "axes": [
      {"axis":"TRUST","evidence_candidates":["official_credentials","transparent_scope","named_contact","third_party_proof"],"derivation_rule":"Increase only when independently verifiable trust signals are present and relevant to the buyer risk.","confidence_rule":"High requires two evidence classes; medium one direct class; otherwise low or UNKNOWN.","unknown_policy":"Do not invent trust claims."},
      {"axis":"CRAFT","evidence_candidates":["process_detail","materials","tools","quality_control","maker_statement"],"derivation_rule":"Increase when the business truth exposes repeatable skill, process or material decisions.","confidence_rule":"High requires direct process or material evidence.","unknown_policy":"Use UNKNOWN when craft is asserted but not shown."},
      {"axis":"PLACE","evidence_candidates":["location","service_area","workshop","local_context","access"],"derivation_rule":"Increase when place materially changes the service, trust or customer experience.","confidence_rule":"High requires official place evidence plus service relevance.","unknown_policy":"Do not infer locality from a Japanese address alone."},
      {"axis":"PREMIUM","evidence_candidates":["price_position","customer_segment","channel","official_positioning","scarcity_or_selectivity"],"derivation_rule":"Increase only when price, audience, channel or official positioning jointly support a premium posture.","confidence_rule":"High requires at least two direct evidence classes.","unknown_policy":"No luxury language from visual taste alone."},
      {"axis":"ENERGY","evidence_candidates":["service_pace","brand_verbs","event_frequency","motion_or_activity_evidence"],"derivation_rule":"Increase when the business truth indicates speed, activity, change or participation.","confidence_rule":"High requires observable behavior, not color preference.","unknown_policy":"Do not use energetic expression to compensate for missing business energy."},
      {"axis":"TECHNICAL","evidence_candidates":["specification","system_description","workflow","qualification","performance_constraint"],"derivation_rule":"Increase when technical complexity is a real buyer concern and is evidenced by documents or process.","confidence_rule":"High requires direct technical evidence.","unknown_policy":"Do not equate dark UI with technicality."},
      {"axis":"WARMTH","evidence_candidates":["people","voice","care_process","customer_language","place"],"derivation_rule":"Increase when human care or relational behavior is evidenced.","confidence_rule":"High requires people/process evidence.","unknown_policy":"Avoid generic friendly adjectives."},
      {"axis":"INNOVATION","evidence_candidates":["new_method","new_category","R&D","technology_adoption","official_innovation_claim"],"derivation_rule":"Increase only when a new method or category position is evidenced.","confidence_rule":"High requires specific official evidence.","unknown_policy":"No innovation claim from unusual visual design."},
      {"axis":"HUMAN","evidence_candidates":["founder","staff","maker","customer_interaction","named_people"],"derivation_rule":"Increase when named people or direct human interaction is central to the offer.","confidence_rule":"High requires official people evidence.","unknown_policy":"Do not use stock people as proof of human authority."},
      {"axis":"AUTHORITY","evidence_candidates":["qualification","history","institutional_role","recognized_proof","published_knowledge"],"derivation_rule":"Increase when the company has relevant, verifiable authority for the buyer decision.","confidence_rule":"High requires source-backed authority.","unknown_policy":"Never substitute award prestige for business authority."},
      {"axis":"EDITORIAL","evidence_candidates":["complex_story","multiple_offers","point_of_view","content_depth","chapter_structure"],"derivation_rule":"Increase when editing and sequencing are necessary to make the offer understood.","confidence_rule":"Based on information structure, not serif typography.","unknown_policy":"Use neutral structure when no editorial need exists."},
      {"axis":"PLAY","evidence_candidates":["participation","game_like_action","surprise","audience_behavior","campaign_context"],"derivation_rule":"Increase when play is consistent with the audience and conversion job.","confidence_rule":"High requires a real participation or campaign reason.","unknown_policy":"Do not add play to make a weak offer interesting."},
      {"axis":"PRECISION","evidence_candidates":["measurement","spec","repeatability","grid_or_system_in_business","quality_control"],"derivation_rule":"Increase when accuracy and repeatability are customer-relevant and evidenced.","confidence_rule":"High requires measurable or procedural evidence.","unknown_policy":"No precision inference from geometric decoration."},
      {"axis":"TRANSPARENCY","evidence_candidates":["price","scope","process","limitations","contact_aftercare"],"derivation_rule":"Increase when the business openly defines cost, scope, boundaries or next steps.","confidence_rule":"High requires at least two concrete disclosures.","unknown_policy":"Do not claim transparency when key conditions are unknown."},
      {"axis":"INTIMACY","evidence_candidates":["private_context","one_to_one_service","sensitive_problem","small_scale_contact"],"derivation_rule":"Increase when the buyer must feel personally understood or protected.","confidence_rule":"High requires actual service context.","unknown_policy":"Do not confuse small business size with intimacy."},
      {"axis":"URGENCY","evidence_candidates":["deadline","capacity","seasonality","risk_of_delay","campaign_period"],"derivation_rule":"Increase only when a factual time condition changes the decision.","confidence_rule":"High requires dated or operational evidence.","unknown_policy":"No artificial scarcity or urgency."}
    ]
  },
  "evidence_grade": {
    "allowed_values":["E0","E1","E2","E3","E4"],
    "definitions": {
      "E0":"Discovery pointer or thumbnail only",
      "E1":"Award, gallery or portfolio description without original-page verification",
      "E2":"Original or official live page verified",
      "E3":"Original or official page plus desktop and mobile snapshot review",
      "E4":"E3 plus multi-scene mechanism evidence and source-backed transfer note"
    },
    "forbidden_aliases":["M0","M1","M2","M3"]
  },
  "evidence_snapshot_schema": {
    "required_fields":["captured_at","viewport","original_url","evidence_locator","screenshot_identifier","content_hash"],
    "optional_fields":["archive_uri","page_title","http_status","rights_note","capture_tool_version"],
    "hash_algorithm":"sha256"
  },
  "storage_policy": {
    "git_repository_stores":["metadata","URL","locator","viewport","captured_at","content_hash","screenshot_identifier","archive_uri","rights_note"],
    "git_repository_does_not_store":["bulk_screenshots","large_video_files","binary_capture_batches"],
    "archive_location":"External versioned evidence archive or bounded CI artifact storage, referenced by archive_uri",
    "content_addressed_key":"evidence/<reference_id>/<captured_at>/<viewport>/<content_hash>.<ext>",
    "reproducibility_rule":"A missing archive object changes evidence grade to HOLD; metadata is never treated as visual evidence by itself"
  },
