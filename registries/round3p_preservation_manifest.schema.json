{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/discegaudere1202-maker/lp-creative-director-engine/registries/round3p_preservation_manifest.schema.json",
  "title": "Round3P Preservation Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "case_id",
    "baseline",
    "preserve_ledger",
    "intentional_change_ledger",
    "regression_matrix_requirements",
    "quality_gain_loss_ledger",
    "release_policy"
  ],
  "properties": {
    "manifest_version": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "task_issue": {"type": ["integer", "null"], "minimum": 1},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head_sha", "screenshots", "copy_snapshot", "evidence_state", "viewports"],
      "properties": {
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "pr_number": {"type": ["integer", "null"], "minimum": 1},
        "workflow_run": {"type": ["integer", "null"], "minimum": 1},
        "artifact_id": {"type": ["integer", "null"], "minimum": 1},
        "artifact_name": {"type": ["string", "null"]},
        "artifact_digest": {"type": ["string", "null"]},
        "screenshots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "kind"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "kind": {"enum": ["DESKTOP_FULL", "MOBILE_FULL", "SCENE_CAPTURE", "COMPARISON"]},
              "viewport": {"type": ["integer", "null"], "minimum": 1}
            }
          }
        },
        "copy_snapshot": {"type": "string", "minLength": 1},
        "evidence_state": {"type": "string", "minLength": 1},
        "viewports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        }
      }
    },
    "preserve_ledger": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["preserve_id", "scope", "layer", "level", "preserve_type", "description", "comparison_method", "status"],
        "properties": {
          "preserve_id": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "layer": {"enum": ["TRUTH", "COPY", "DESIGN", "MEDIA", "INTERACTION", "RESPONSIVE", "SAFETY", "CONVERSION", "QUALITY"]},
          "level": {"enum": ["HARD", "MATERIAL", "SOFT"]},
          "preserve_type": {"enum": ["PIXEL", "SEMANTIC", "PRINCIPLE", "BEHAVIOR", "EVIDENCE_BOUNDARY"]},
          "description": {"type": "string", "minLength": 1},
          "comparison_method": {"type": "string", "minLength": 1},
          "status": {"enum": ["ACTIVE", "REOPENED", "DEPRECATED"]}
        }
      }
    },
    "intentional_change_ledger": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["change_id", "target", "problem", "expected_gain", "preserve_refs", "acceptance_evidence"],
        "properties": {
          "change_id": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "viewports": {"type": "array", "items": {"type": "integer", "minimum": 1}, "uniqueItems": true},
          "problem": {"type": "string", "minLength": 1},
          "expected_gain": {"type": "string", "minLength": 1},
          "copy_impact": {"type": "string"},
          "design_impact": {"type": "string"},
          "responsive_impact": {"type": "string"},
          "safety_evidence_impact": {"type": "string"},
          "preserve_refs": {"type": "array", "items": {"type": "string"}},
          "allowed_collateral_change": {"type": "array", "items": {"type": "string"}},
          "forbidden_collateral_change": {"type": "array", "items": {"type": "string"}},
          "acceptance_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "regression_matrix_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classifications", "responsive_viewports", "incidental_change_default"],
      "properties": {
        "classifications": {
          "const": ["INTENTIONAL_CHANGE", "PRESERVED", "INCIDENTAL_CHANGE", "REGRESSION"]
        },
        "responsive_viewports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "incidental_change_default": {"const": "RETURN_UNTIL_CLASSIFIED"}
      }
    },
    "quality_gain_loss_ledger": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["change_id", "quality_gain", "quality_loss", "preserved_elements", "conclusion"],
        "properties": {
          "change_id": {"type": "string", "minLength": 1},
          "quality_gain": {"type": "array", "items": {"type": "string"}},
          "quality_loss": {"type": "array", "items": {"type": "string"}},
          "preserved_elements": {"type": "array", "items": {"type": "string"}},
          "conclusion": {"enum": ["PASS", "RETURN", "PENDING"]}
        }
      }
    },
    "rejected_signatures": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "release_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hard_loss", "material_loss", "incidental_change", "overall_gain_override"],
      "properties": {
        "hard_loss": {"const": "FAIL"},
        "material_loss": {"const": "FAIL_UNLESS_EXPLICITLY_REOPENED"},
        "incidental_change": {"const": "RETURN_UNTIL_CLASSIFIED"},
        "overall_gain_override": {"const": false}
      }
    }
  }
}
